# URL de connexion à la base de données PostgreSQL (Vercel Postgres, Neon, etc.)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Clé secrète pour signer les sessions — génère la tienne avec : openssl rand -base64 32
AUTH_SECRET="remplace-moi-par-une-valeur-aleatoire"

# Mot de passe temporaire du tout premier compte admin (créé au seed)
ADMIN_PASSWORD="ChangeMoi123!"
